# Copy to .env.local. Every variable is optional: without them the app
# uses template excuses ("Offline mode") and demo events ("Demo data").

# LLM provider (OpenAI-compatible chat completions). Set all three or none.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Ticketmaster Discovery API key for real nearby events.
TICKETMASTER_API_KEY=

# Shared rate-limit counters (Upstash Redis REST, free tier). Set both or neither.
# Vercel's Upstash integration sets these as KV_REST_API_URL / KV_REST_API_TOKEN,
# which also work. Without them limits are kept in memory per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
