# Copy to .env.local. Every variable is optional: without them the app
# uses template excuses ("Offline mode") and demo events ("Demo data").

# LLM provider (OpenAI-compatible chat completions). Set all three or none.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Ticketmaster Discovery API key for real nearby events.
TICKETMASTER_API_KEY=
